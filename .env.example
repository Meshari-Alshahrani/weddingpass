# ==============================================================================
# WeddingPass - Environment Variables Template
# ==============================================================================
# انسخ هذا الملف وسمّه .env.local وضع قيمك الخاصة فيه
# هذا الملف محمي بالكامل في .gitignore ولن يتم رفعه لـ GitHub أبداً
# ==============================================================================

# 1. إعدادات قاعدة بيانات Supabase (مطلوبة في الإنتاج)
# استخدم الأسماء الحديثة، أو البدائل legacy التالية إذا كانت إعداداتك القديمة تعتمدها:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-service-role-secret-key-here
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. إعدادات الدومين والإنتاج (اختياري - يحدده النظام تلقائياً إذا لم تضعه)
# NEXT_PUBLIC_BASE_URL=https://your-custom-domain.com

# 3. أسرار الجلسات والبوابات (مطلوبة في الإنتاج؛ أنشئ قيمة عشوائية قوية لكل متغير)
GATE_SESSION_SECRET=replace-with-a-unique-random-32-plus-character-secret
ADMIN_SECRET=replace-with-a-unique-random-32-plus-character-secret
SUPERVISOR_PIN=replace-with-a-long-private-supervisor-pin

# 4. حماية معدل الطلبات (الإعداد الافتراضي في الإنتاج هو distributed)
# اختر local صراحةً فقط عند عدم استخدام Redis/KV؛ لا تتركه بلا قرار.
RATE_LIMITER_MODE=distributed
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# بدائل Vercel KV المدعومة:
# KV_REST_API_URL=https://your-kv-rest-endpoint
# KV_REST_API_TOKEN=your-kv-rest-token

# 5. التطوير المحلي فقط: يفعّل البيانات الوهمية عند غياب Supabase.
# لا تضعه في Vercel أو أي بيئة إنتاج.
# WEDDINGPASS_ALLOW_MOCK=true

# 6. اختبار التكامل ضد Supabase حقيقية (لا يشغّل تلقائيًا)
# RUN_SUPABASE_INTEGRATION=true
